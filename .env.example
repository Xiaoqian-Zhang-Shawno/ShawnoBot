# Feishu Open Platform credentials.
# Copy this file to .env and replace the placeholders locally.
FEISHU_APP_ID=cli_replace_with_your_app_id
FEISHU_APP_SECRET=replace_with_your_app_secret

# Optional: only required when the DeepSeek natural-language translator is enabled.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# Optional: defaults to config.yaml in the repository root.
# SHAWNOBOT_CONFIG=C:\path\to\ShawnoBot\config.yaml
